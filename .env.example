# ============================================================
# agent-runtime 环境变量样例
# 复制为 .env 后按需修改。所有敏感配置一律通过环境变量注入，
# 禁止硬编码在代码中。
# ============================================================

# ---------- LLM 配置（OpenAI-compatible HTTP API）----------
# provider: auto | openai | stub
#   auto   = 设置了 LLM_BASE_URL 且 LLM_API_KEY 非空时用 openai，否则用 stub
#   openai = 强制走真实 OpenAI-compatible 接口（LLM_BASE_URL 必填）
#   stub   = 使用内置确定性假模型（离线可跑，用于教学 / 测试 / 无 Key 演示）
LLM_PROVIDER=auto
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# 请求超时（秒）
LLM_TIMEOUT_SECONDS=60
# LLM 调用瞬时错误重试次数（网络断连 / 5xx 重试；4xx 不重试）
LLM_MAX_RETRIES=2
# LLM 重试间隔（秒，指数退避基数）
LLM_RETRY_BACKOFF=1.0

# ---------- Embedding（Stage 8 记忆层向量化）----------
# provider: auto | openai | stub
#   openai = OpenAI-compatible /embeddings 接口（如阿里云百炼 qwen3.7-text-embedding）
#   stub   = 确定性 hash 伪向量（离线教学 / 测试，无语义相似度）
EMBEDDING_PROVIDER=auto
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT_SECONDS=30
# 向量维度（sqlite-vec 建表用；实际维度以 embedding 接口返回为准）
EMBEDDING_DIM=1024

# ---------- Memory（Stage 8 记忆层）----------
# 记忆层总开关：true 且 AgentRuntime 注入 MemoryStore 后生效
MEMORY_ENABLED=false
# 检索 Top-K 召回条数
MEMORY_TOP_K=5
# 检索最小相似度阈值（低于该值不注入上下文，防噪音）
MEMORY_MIN_SCORE=0.35
# 回合结束后自动提炼事实写入记忆
MEMORY_AUTO_EXTRACT=true
# 事实提炼策略: stub(确定性规则) | llm(模型提炼) | off(关闭)
MEMORY_EXTRACT_STRATEGY=stub
# 重排序策略: stub(规则重排) | llm(模型重排) | off(跳过，朴素 Top-K)
MEMORY_RERANK_STRATEGY=stub
# 粗召回倍数：先召回 top_k * 该倍数 的候选，再重排取最终 top_k
MEMORY_RERANK_CANDIDATE_MULTIPLIER=3
# 规则重排时关键词重叠的权重（0~1；语义分数权重为 1 - 该值）
MEMORY_RERANK_KEYWORD_WEIGHT=0.3

# ---------- Redis（第四阶段队列）----------
# 本地 Docker: redis://localhost:6379/0
# Docker Compose 内部: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
# 队列名 / 键前缀
QUEUE_NAME=agent:jobs:queue
JOB_KEY_PREFIX=agent:jobs:
REQUEST_KEY_PREFIX=agent:requests:

# ---------- SQLite（第三阶段 Session / Checkpoint）----------
# sqlite:///绝对路径 或 sqlite:///./相对路径
DATABASE_URL=sqlite:///./data/agent.db

# ---------- Agent 运行时 ----------
# Context Builder 滑动窗口：最多送入模型的最近消息条数
MAX_CONTEXT_MESSAGES=10
# 历史超过该条数时触发压缩（生成 summary）
CONTEXT_SUMMARY_THRESHOLD=16
# 压缩策略: stub(确定性摘要) | llm(调用模型总结) | off(关闭压缩)
CONTEXT_SUMMARY_STRATEGY=stub
# 单轮对话最大循环步数（防止 Tool Loop 死循环）
MAX_AGENT_STEPS=8
# 单条 Tool 调用失败后的最大重试次数（Gateway 层）
MAX_TOOL_RETRIES=2
# Tool 默认超时（秒）
TOOL_DEFAULT_TIMEOUT_SECONDS=10.0

# ---------- Stage 9 规划层 ----------
# 执行模式: react(单层 ReAct) | plan(计划→执行→反思)
AGENT_MODE=react
# 规划策略: stub(规则分解) | llm(模型计划)
PLANNER_STRATEGY=stub
# 反思触发的最大重规划次数（防死循环）
MAX_PLAN_REVISIONS=2
# 计划的步骤数上限
MAX_PLAN_STEPS=6

# ---------- 队列 / Job ----------
# Job 最大尝试次数（失败重试上限，避免无限重试）
MAX_ATTEMPTS=3
# Job 元数据 TTL（秒）
JOB_TTL_SECONDS=86400

# ---------- 真实工具（工具生态）----------
# Tavily Web Search API Key（web_search 工具 / RAG 网络检索共用）
# 获取: https://app.tavily.com
TAVILY_API_KEY=
# 天气：QWeather（和风天气，优先于 Open-Meteo）
# 获取: https://dev.qweather.com（需注册，免费额度）
QWEATHER_HOST=
QWEATHER_API_KEY=
# 天气回退：Open-Meteo 免费 API（无需 key）；false 则用内置 Stub 数据
WEATHER_USE_REAL_API=true
# 文件工具沙箱根目录（file_read/file_write 与 MCP filesystem 共用此目录，
# 需与 MCP_SERVERS 里 fs server 的目录参数保持一致；建议绝对路径）
SANDBOX_DIR=./data/mcp_fs
# 邮件工具（QQ SMTP）：SMTP_USER 为发件人邮箱，SMTP_PASSWORD 为授权码
# QQ 邮箱设置 -> 账户 -> 开启 SMTP 服务生成授权码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# ---------- Policy（工具策略）----------
# 需要人工确认的风险等级（逗号分隔，如 high,medium）
# 当前无确认通道：留空 = 全部放行；后续引入 LLM 危险度评估后恢复
POLICY_REQUIRE_CONFIRMATION_RISKS=
# 工具默认风险等级（MCP 外部工具注册时）
TOOL_DEFAULT_RISK_LEVEL=low

# ---------- Skill 系统 ----------
# 技能目录（skills/ 下每个子目录一个技能，含 SKILL.md）
SKILLS_DIR=./skills
# 技能总开关
SKILLS_ENABLED=true
# 匹配策略: trigger(触发词规则) | llm(模型语义匹配)
SKILL_MATCH_STRATEGY=trigger

# ---------- MCP（Model Context Protocol 外部工具接入）----------
# MCP_SERVERS: JSON 数组，描述要连接的 MCP Server
#   stdio（本地子进程）: {"name":"filesystem","transport":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/tmp"]}
#   sse（远程 HTTP）:   {"name":"remote","transport":"sse","url":"https://example.com/mcp"}
# 例: MCP_SERVERS=[{"name":"fs","transport":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/tmp"]}]
MCP_SERVERS=[]
# 连接超时（秒）
MCP_CONNECT_TIMEOUT_SECONDS=15
# 工具调用转发到 MCP Server 的超时（秒）
MCP_TOOL_TIMEOUT_SECONDS=30

# ---------- Tracing（第六阶段）----------
TRACE_ENABLED=true
# 是否把完整 Prompt / 工具参数写入 Trace。
# 默认 false：只写摘要与元数据，避免敏感内容被永久落盘。
TRACE_CAPTURE_CONTENT=false
TRACE_FILE=traces/traces.jsonl

# ---------- Eval ----------
# 评测结果保存目录
EVAL_RUN_DIR=evals/runs
